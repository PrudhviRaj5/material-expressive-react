  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prudhviraj5/material-expressive-react.git"
  },
  "homepage": "https://prudhviraj5.github.io/material-expressive-react/",
  "bugs": {
    "url": "https://github.com/prudhviraj5/material-expressive-react/issues"
  },
  "scripts": {
    "clean": "rm -rf dist storybook-static",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node ./scripts/generate-wrappers.mjs",
    "build": "npm run clean && vite build && npm run typecheck",
    "prepack": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:generate": "node ./scripts/generate-docs.mjs",
    "docs:build": "npm run docs:generate && cd docs && npm run build",
    "pages:build": "node ./scripts/build-pages.mjs",
    "pages:serve": "node ./scripts/serve-pages.mjs pages-dist 5173",
    "pack:check": "npm pack --silent && node -e \"const fs=require('node:fs'); const tgz=fs.readdirSync('.').find(f=>f.endsWith('.tgz')); if(!tgz) throw new Error('No .tgz produced'); console.log('Created', tgz);\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@material/web": "^2.4.1"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.17",
    "@storybook/addon-interactions": "8.6.17",
    "@storybook/addon-links": "8.6.17",
    "@storybook/react-vite": "8.6.17",
    "@storybook/test": "8.6.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "8.6.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "react-docgen-typescript": "^2.2.2"
  }
}
